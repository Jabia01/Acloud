{
  "name": "@backup/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/main.js",
    "test": "jest --runInBand",
    "test:integration": "node --env-file=../../.env --import tsx --test --test-concurrency=1 test/database.integration.ts test/auth.integration.ts test/dashboard.integration.ts test/admin.integration.ts test/billing.integration.ts test/billing-migration.integration.ts test/paystack-provider.test.ts test/storage-provider.test.ts test/b2-domain.integration.ts test/storage-migration.integration.ts test/local-cleanup.integration.ts test/hardening.test.ts test/hardening.integration.ts test/beta.test.ts test/beta.integration.ts test/acceptance.test.ts test/lifecycle.test.ts test/lifecycle.integration.ts test/preview.test.ts",
    "test:uploads": "node --env-file=../../.env --import tsx --test --test-concurrency=1 test/upload.integration.ts",
    "test:billing": "node --env-file=../../.env --import tsx --test --test-concurrency=1 test/billing.integration.ts test/billing-migration.integration.ts test/paystack-provider.test.ts",
    "test:storage": "node --import tsx --test test/storage-provider.test.ts",
    "test:cleanup": "node --env-file=../../.env --import tsx --test test/local-cleanup.integration.ts",
    "test:hardening": "node --env-file=../../.env --import tsx --test --test-concurrency=1 test/hardening.test.ts test/hardening.integration.ts",
    "test:beta": "node --env-file=../../.env --import tsx --test --test-concurrency=1 test/beta.test.ts test/beta.integration.ts",
    "test:lifecycle": "node --env-file=../../.env --import tsx --test --test-concurrency=1 test/lifecycle.test.ts test/lifecycle.integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@backup/shared": "0.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "argon2": "^0.45.1",
    "nodemailer": "^10.0.13",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5"
  }
}
