# Template only. No deployment, credentials, endpoints or PASS evidence supplied.
NODE_ENV=production
APP_ENV=staging
BETA_ENABLED=false
BETA_INVITE_REQUIRED=true
BETA_ALLOW_REAL_MEDIA=false
BETA_ALLOW_PAYMENTS=false
BETA_ALLOW_FREE_UP_SPACE=false
BETA_ALLOW_B2=false
BETA_ALLOW_SUPPORT_TOOLS=false
BETA_MAX_USERS=25
BETA_MAX_STORAGE_BYTES=125000000000
MAX_USER_STORAGE_BYTES=5000000000
MAX_ACTIVE_DEVICES=3
MAX_CONCURRENT_UPLOADS=3
MAX_SINGLE_FILE_SIZE=1073741824
MAX_DAILY_UPLOAD_BYTES=5000000000
BETA_ENVIRONMENT_ID=
BETA_RELEASE_ID=
BETA_DATABASE_NAME=
BETA_EXPECTED_BUCKET=
BETA_MIN_APP_VERSION=0.1.0
DATABASE_URL=
DATABASE_CA_FILE=
STORAGE_PROVIDER=backblaze_b2
STORAGE_ENVIRONMENT=staging
B2_BUCKET_NAME=
B2_BUCKET_ID=
B2_REGION=
B2_S3_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
API_PUBLIC_ORIGIN=
WEB_ORIGIN=
STAFF_ORIGIN=
STAFF_RP_ID=
CORS_ORIGINS=
TRUST_PROXY=false
SECURE_COOKIES=true
RATE_LIMIT_BACKEND=postgres
RATE_LIMIT_KEY_SECRET=
ADMIN_MFA_REQUIRED=true
MFA_ENCRYPTION_KEY=
INTERNAL_ADMIN_ENABLED=true
ALLOW_ADMIN_BOOTSTRAP=false
CUSTOMER_REGISTRATION_ENABLED=false
ENABLE_FREE_UP_SPACE=false
DISPOSABLE_CLEANUP_CONTEXT=false
MOCK_BILLING_ENABLED=false
DEBUG_ENDPOINTS_ENABLED=false
DEV_MAIL_ENABLED=false
DEV_PHOTOKIT_ENABLED=false
B2_LIVE_TEST_ENABLED=false
ALLOW_LIVE_STORAGE_TESTS=false
BILLING_ENABLED=false
PAYSTACK_ENVIRONMENT=TEST
PAYSTACK_SECRET_KEY=
EMAIL_PROVIDER=smtp
SMTP_TLS=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AUDIT_ARCHIVE_DIR=/var/lib/backup-beta/audit
AUDIT_ARCHIVE_KEY=
ACCOUNT_DELETION_ENABLED=false
PRIVACY_RETENTION_APPROVED=false

BETA_PRIVACY_NOTICE_URL=
BETA_TERMS_URL=

BETA_DEPLOYMENT_FINGERPRINT=

RESTORE_ENABLED=false

# Complex Photos creation requires separate physical fidelity acceptance.
COMPLEX_PHOTOS_RESTORE_ENABLED=false
MEDIA_MANIFEST_MAX_RESOURCES=16

# Railway additions: public certificate as multiline PEM, never skip TLS validation.
DATABASE_CA_PEM=
PORT=3001
ACCOUNT_DELETION_EXECUTION_ENABLED=false
RETENTION_EXECUTION_ENABLED=false
LIFECYCLE_LEDGER_KEY=
RAILWAY_VOLUME_MOUNT_PATH=/data
# Persistent directories must already be owned by UID 1000; do not run app as root.
LIFECYCLE_LEDGER_DIR=/data/ledger
AUDIT_ARCHIVE_DIR=/data/audit

# Optional, time-limited staging owner console preview; keep disabled by default.
STAFF_OWNER_READ_ONLY_ENABLED=false
STAFF_OWNER_READ_ONLY_ADMIN_ID=
STAFF_OWNER_READ_ONLY_EXPIRES_AT=

# Leave disabled until the private payment-test code and verified TEST prices are deployed.
OWNER_PAYMENT_TEST_ENABLED=false
OWNER_PAYMENT_TEST_ACCOUNT_ID=
OWNER_PAYMENT_TEST_RESOURCE_HASH=
OWNER_PAYMENT_TEST_STARTS_AT=
OWNER_PAYMENT_TEST_EXPIRES_AT=
