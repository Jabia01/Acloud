# LOCAL DEVELOPMENT ONLY. Never reuse these credentials outside local development.
POSTGRES_USER=backup_dev
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=backup_dev
DATABASE_URL=postgresql://backup_dev:local_dev_only_change_me@127.0.0.1:5432/backup_dev
API_PORT=3001
# Server-only Next.js setting; no browser-visible storage or database configuration.
API_BASE_URL=http://127.0.0.1:3001
PRODUCT_NAME=Acloud
# Development-only SMTP sink; Mailpit has no production delivery.
DEV_MAIL_ENABLED=true
DEV_SMTP_HOST=127.0.0.1
WEB_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Generate ignored local credentials with npm run storage:configure; never reuse in production.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=backup-dev-objects
UPLOAD_MAX_BYTES=5242880
FREE_DEV_QUOTA_BYTES=20971520
UPLOAD_TTL_SECONDS=300
DOWNLOAD_TTL_SECONDS=60

# ACL-005 multipart: separate durable session and short-lived part capability.
MULTIPART_MAX_BYTES=1073741824
MULTIPART_PART_BYTES=8388608
MULTIPART_SESSION_SECONDS=604800
# For generated 100/500 MiB tests only, raise FREE_DEV_QUOTA_BYTES explicitly.

# Development-only internal operations. Production is blocked pending MFA/passkeys.
INTERNAL_ADMIN_ENABLED=false
INTERNAL_WEB_ORIGIN=http://localhost:3000

# Billing fails closed without explicit environment-specific pricing and provider credentials.
BILLING_ENABLED=false
PAYSTACK_SECRET_KEY=

# ACL-008: local MinIO default. Production explicitly requires backblaze_b2.
STORAGE_PROVIDER=minio
STORAGE_ENVIRONMENT=development
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
ALLOW_LIVE_STORAGE_TESTS=false
EXPECTED_TEST_BUCKET=

# ACL-009: destructive local cleanup disabled; production always refuses enablement.
ENABLE_FREE_UP_SPACE=false
DISPOSABLE_CLEANUP_CONTEXT=false

# ACL-010 production hardening; no infrastructure/provider enablement is implied.
APP_ENV=development
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_MAX_KEYS=100000
ADMIN_MFA_REQUIRED=false
MFA_ENCRYPTION_KEY=
STAFF_ORIGIN=
STAFF_RP_ID=
DATABASE_CA_FILE=
SECURE_COOKIES=false
API_PUBLIC_ORIGIN=
CORS_ORIGINS=
TRUST_PROXY=false
SENSITIVE_LOGGING=false
MAX_ACTIVE_SESSIONS=10
MAX_ACCOUNT_DEVICES=20
MAX_DEVICE_ACCOUNTS=5
MAX_PENDING_UPLOADS=1000
MAX_PARALLEL_MULTIPART=10
ACCOUNT_DELETION_ENABLED=false
PRIVACY_RETENTION_APPROVED=false
DELETION_COOLDOWN_SECONDS=604800
CUSTOMER_REGISTRATION_ENABLED=false
EMAIL_PROVIDER=local
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=false
PAYSTACK_ENVIRONMENT=TEST

# ACL-011: invite-only beta is off until release/environment evidence is accepted.
BETA_ENABLED=false
BETA_INVITE_REQUIRED=true
BETA_MAX_USERS=25
BETA_MAX_STORAGE_BYTES=125000000000
BETA_ALLOW_REAL_MEDIA=false
BETA_ALLOW_PAYMENTS=false
BETA_ALLOW_FREE_UP_SPACE=false
BETA_ALLOW_B2=false
BETA_ALLOW_SUPPORT_TOOLS=false
BETA_ENVIRONMENT_ID=
BETA_RELEASE_ID=
BETA_DATABASE_NAME=
BETA_EXPECTED_BUCKET=
BETA_MIN_APP_VERSION=
MAX_USER_STORAGE_BYTES=5000000000
MAX_ACTIVE_DEVICES=3
MAX_CONCURRENT_UPLOADS=3
MAX_SINGLE_FILE_SIZE=1073741824
MAX_DAILY_UPLOAD_BYTES=5000000000
AUDIT_ARCHIVE_DIR=
AUDIT_ARCHIVE_KEY=

BETA_PRIVACY_NOTICE_URL=
BETA_TERMS_URL=

# Server-authorized restore remains off until physical acceptance.
RESTORE_ENABLED=false

# Complex Photos creation requires separate physical fidelity acceptance.
COMPLEX_PHOTOS_RESTORE_ENABLED=false
MEDIA_MANIFEST_MAX_RESOURCES=16

# ACL-015 execution remains disabled pending reviewed policy and independent ledger acceptance.
ACCOUNT_DELETION_EXECUTION_ENABLED=false
RETENTION_EXECUTION_ENABLED=false
LIFECYCLE_BATCH_SIZE=50
LIFECYCLE_RETRY_LIMIT=8
LIFECYCLE_LEDGER_DIR=
LIFECYCLE_LEDGER_KEY=
LIFECYCLE_IDENTITY_HMAC_KEY=
PRIVACY_EXPORT_KEY=
PRIVACY_EXPORT_BATCH_SIZE=250
PRIVACY_EXPORT_RETENTION_HOURS=24

# Optional, time-limited staging owner console preview; keep disabled by default.
STAFF_OWNER_READ_ONLY_ENABLED=false
STAFF_OWNER_READ_ONLY_ADMIN_ID=
STAFF_OWNER_READ_ONLY_EXPIRES_AT=

# Small saved thumbnails have a separate pause control from original downloads.
THUMBNAILS_ENABLED=true
